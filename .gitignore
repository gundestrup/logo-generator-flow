# Build artifacts
/logo-generator
*.exe
*.test
*.out

# Generated output
output/*
!output/.gitkeep

# Coverage
coverage.out
coverage.html

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Personal Devin-agent permission overrides
.devin/config.local.json

# Node
/node_modules/

# Demo-media working frames (regenerate via scripts/docs-demo.sh)
/data/

# Tooling caches
.semgrep-cache/

# Local user assets — never commit custom fonts/configs/templates
assets/fonts/*
!assets/fonts/.gitkeep
configs/borg*.json
templates/Borg-Collective*.svg
templates/borg-collective.svg
/Borg-Collective_template*.svg
/Borg-Collective_template*.vectorcraft
# Personal image assets — only the three demo assets are tracked
assets/images/*
!assets/images/badge.svg
!assets/images/mark.svg
!assets/images/photo.png
